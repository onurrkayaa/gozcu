# Sanal ortam
.venv/

# Veri kümesi - depoya girmez, boyutu büyük ve lisansı ayrı (CC BY 4.0)
data/

# Uretilen ciktilar - secici izleme.
# Olcum CSV'leri depoya girer: rapor metinlerinin atif yaptigi sayilar ve
# kutu bazinda kayitlar bunlarin icinde. Kutu bazinda kayitlar buyuk, ama
# uretimleri saatler surdugu icin "yeniden uretilebilir" sayilmazlar.
# Karo manifesti 3 dakikada yeniden uretildigi icin disarida kalir; gorseller,
# loglar ve alt dizinler de oyle. Ayrinti: reports/README.md
reports/*
!reports/*.csv
!reports/README.md
# Rapor gövdesinde kullanılan tek grafik: birleşik rapor GitHub'da okunurken
# kırık görünmesin diye izlenir. Üreteci: scripts/04_kutu_boyutu_analiz.py
!reports/recall_vs_kutu_boyutu.png
# Olcum protokolu metni: sonuclar gorulmeden once sabitlenmis bir karar
# belgesi, yeniden uretilemez. Bu yuzden .md olmasina ragmen izlenir.
!reports/hafta7_fp_protokolu.md
reports/karo_veri_manifest_*.csv
# Kor etiketleme kirpimlari: kaynak goruntulerden script ile yeniden
# uretilebilir ve binlerce dosyadir; depoya girmez.
reports/hafta7_kirpimlar/

# Egitim agirliklari ve Kaggle kosu ciktisi - buyuk ikili dosyalar depoya girmez.
# Egitim metrikleri reports/model512_egitim.csv olarak ayrica izleniyor.
agirliklar/*.pt
agirliklar/*.onnx
egitim/kaggle_cikti/

# Model ağırlıkları - ilk çalıştırmada otomatik iner
*.pt

# Uretilen rapor ciktilari.
#
# Kaynak bolum_*.md dosyalari depoda durur. Birlesik MARKDOWN da izlenir:
# tek dosyada okunabilen rapor, deponun ana ciktilarindan biri ve GitHub
# uzerinde dogrudan okunabiliyor. Uretimi saniyeler surdugu icin ciktinin
# kaynakla ayrisma riski dusuk; scripts/06_rapor_uret.py ile yeniden uretilir.
# PDF (4,4 MB, gomulu ekran goruntuleriyle) depoya girmez.
rapor/GOZCU_RAPOR_TR.pdf
rapor/rapor.md
rapor/rapor.pdf

# Django collectstatic ciktisi
backend/staticfiles/*
!backend/staticfiles/.gitkeep

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# macOS
.DS_Store

# Ortam degiskenleri - sirlar depoya girmez
.env

# Kaggle API kimligi - normalde ~/.kaggle icinde durur, kazaen proje
# kokune kopyalanirsa depoya girmesin
kaggle.json

# Yuklenen goruntuler
backend/media/*
!backend/media/.gitkeep

# Pahali kosularin yedegi - depoya girmez, yerelde kalir
reports_yedek_*/

# Frontend bagimliliklari ve derleme ciktisi
frontend/node_modules/
frontend/dist/

# Tarayici otomasyon araci gecici ciktilari
.playwright-mcp/
