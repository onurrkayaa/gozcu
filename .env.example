# PostgreSQL / PostGIS
POSTGRES_DB=gozcu
POSTGRES_USER=gozcu
POSTGRES_PASSWORD=degistir-beni
DB_HOST=db
DB_PORT=5432

# Django
# Uretmek icin: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Redis / Celery
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Gercek dedektor modeli (Hafta 4). Agirlik dosyasi depoya girmez.
# docker-compose bu degeri kendisi /models/model512_best.onnx olarak verir ve
# ./agirliklar klasorunu salt okunur baglar; burada yalnizca konteyner disinda
# calistirmak icin gerekir.
ONNX_MODEL_PATH=

# Asama bazinda sure olcumu (Hafta 4 olcum kosusu). Bos = kapali.
# Ornek: TASK_TIMING_LOG=/app/media/zamanlama.jsonl
TASK_TIMING_LOG=
