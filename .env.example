# Gozcu ortam degiskenleri.
#
# Bu dosya ORNEKTIR ve depoya girer; gercek sir icermez. Kullanim:
#     cp .env.example .env      ve asagidaki bos alanlari doldurun.
# `./demo.sh` bu dosyayi kendisi kopyalar ve sirlari uretir.
#
# .env dosyasinin kendisi .gitignore icindedir ve ASLA commit edilmez.

# --- PostgreSQL / PostGIS ---------------------------------------------------
# Zorunlu. Parolayi kendi degeriyle degistirin:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_DB=gozcu
POSTGRES_USER=gozcu
POSTGRES_PASSWORD=
# docker compose icinde servis adi "db"; konteyner disindan calistiriyorsaniz
# localhost yazip db servisinin portunu disari acmaniz gerekir.
DB_HOST=db
DB_PORT=5432

# --- Django -----------------------------------------------------------------
# ZORUNLU, varsayilani yok: bos birakilirsa uygulama acilmaz.
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Uretim benzeri kosumda 0 olmali. 1 yapmak hata sayfalarinda kod, ayar ve
# sorgu ayrintilarini gosterir ve CORS'u tum kaynaklara acar.
DJANGO_DEBUG=0

# Zorunlu. Virgulle ayrilmis konak listesi.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Istege bagli. Arayuz nginx uzerinden AYNI kaynaktan konustugu icin normalde
# bos kalir. Arayuzu baska bir adresten servis ediyorsaniz buraya tam kaynak
# yazin (ornek: https://gozcu.ornek.com). Joker (*) DESTEKLENMEZ.
DJANGO_CORS_ORIGINS=
DJANGO_CSRF_TRUSTED_ORIGINS=

# Yalnizca onunde gercek TLS sonlandiran bir ters vekil varsa 1 yapin.
# 1 yapildiginda HSTS, guvenli cerez ve HTTPS yonlendirmesi acilir; duz HTTP
# uzerinde 1 yapmak uygulamayi yonlendirme dongusune sokar.
DJANGO_HTTPS=0

# --- Oturum (JWT) -----------------------------------------------------------
# Erisim belirteci kisa omurlu, yenileme belirteci uzun omurludur.
JWT_ACCESS_DAKIKA=15
JWT_REFRESH_SAAT=12

# --- Hiz siniri -------------------------------------------------------------
# Degerler KARARDIR, olculmus esik degildir. Giris ucu ayri ve dar kovada.
THROTTLE_ANON=60/min
THROTTLE_USER=1000/hour
THROTTLE_GIRIS=10/min

# --- Redis / Celery ---------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Gunicorn ---------------------------------------------------------------
GUNICORN_ISCI=3
GUNICORN_ZAMAN_ASIMI=120

# --- Gercek dedektor modeli -------------------------------------------------
# Agirlik dosyasi (model512_best.onnx) depoya GIRMEZ; agirliklar/ klasorune
# elle konur. docker compose bu degeri kendisi /models/model512_best.onnx
# olarak verir ve klasoru salt okunur baglar; buradaki deger yalnizca
# konteyner disinda calistirmak icin gerekir.
ONNX_MODEL_PATH=

# --- Demo -------------------------------------------------------------------
# Demo hesaplarinin parolasi. Bos birakilirsa komut yerel demo varsayilanini
# kullanir ve DJANGO_DEBUG=0 iken calismayi reddeder.
DEMO_PAROLA=

# --- Olcum ------------------------------------------------------------------
# Asama bazinda sure olcumu (Hafta 4 olcum kosusu). Bos = kapali.
# Ornek: TASK_TIMING_LOG=/app/media/zamanlama.jsonl
TASK_TIMING_LOG=
